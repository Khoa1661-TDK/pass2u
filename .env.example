# Neon Postgres (Vercel > Storage > Neon adds this automatically)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Vercel Blob (Vercel > Storage > Blob adds this automatically)
BLOB_READ_WRITE_TOKEN=
# Long random string: openssl rand -base64 32
SESSION_SECRET=
# Public URL of the site, used in confirmation emails
APP_URL=http://localhost:3000
# Resend (resend.com) for confirmation emails. Without it, links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=PASS2U <onboarding@resend.dev>
# Protects the daily ID-photo purge job
CRON_SECRET=
# Used by `npm run db:seed` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
